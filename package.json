{
  "name": "puzzle-duel-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test 'test/**/*.test.mts'",
    "test:ingress": "node --experimental-strip-types --test --test-concurrency=1 test/tournament/ingress/deadline-boundary.test.mts test/tournament/ingress/durability-fault.test.mts test/tournament/ingress/concurrency-fence.test.mts test/tournament/ingress/postgres-journal.test.mts test/tournament/ingress/p1-remediation.test.mts test/tournament/ingress/phase-a-subgame-isolation.test.mts",
    "test:generator": "node --experimental-strip-types --test test/generator.test.mts",
    "test:core001v3": "node --experimental-strip-types --test 'test/engine/core001v3/**/*.test.mts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:stage-d-parity": "python3 tools/stage_d/parity/run_parity.py",
    "test:stage-d-checksums": "python3 tools/stage_d/parity/verify_checksums.py",
    "test:stage-e": "node --experimental-strip-types --test 'test/tournament/adjudication/**/*.test.mts'",
    "test:stage-f1": "node --experimental-strip-types --test --test-concurrency=1 'test/tournament/claims/**/*.test.mts'",
    "test:stage-f1-auth": "node --experimental-strip-types --test --test-concurrency=1 'test/tournament/auth/**/*.test.mts'",
    "test:stage-f1-http": "node --experimental-strip-types --test --test-concurrency=1 test/tournament/auth/tournament-http-e2e.test.mts",
    "test:stage-f2": "node --experimental-strip-types --test --test-concurrency=1 'test/tournament/results/**/*.test.mts'",
    "test:stage-f2-migrations": "node --experimental-strip-types --test --test-concurrency=1 test/tournament/migrations/f2-production-gate.test.mts",
    "test:stage-f2-failover": "node --experimental-strip-types --test --test-concurrency=1 --test-force-exit test/tournament/migrations/f2-failover-harness.test.mts",
    "test:uat": "node --experimental-strip-types --test --test-concurrency=1 test/tournament/uat/tournament-uat-e2e.test.mts",
    "uat:server": "node --experimental-strip-types src/tournament/uat/uat-server.mts serve",
    "uat:issue": "node --experimental-strip-types src/tournament/uat/uat-server.mts issue",
    "staging:server": "node --experimental-strip-types src/staging/staging-server.mts",
    "test:staging": "node --experimental-strip-types --test test/staging/staging-server.test.mts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
