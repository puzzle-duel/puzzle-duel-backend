{
  "name": "puzzle-duel-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test 'test/**/*.test.mts'",
    "test:generator": "node --experimental-strip-types --test test/generator.test.mts",
    "test:core001v3": "node --experimental-strip-types --test 'test/engine/core001v3/**/*.test.mts'",
    "test:ingress": "node --experimental-strip-types --test --test-concurrency=1 test/tournament/ingress/deadline-boundary.test.mts test/tournament/ingress/durability-fault.test.mts test/tournament/ingress/concurrency-fence.test.mts test/tournament/ingress/postgres-journal.test.mts test/tournament/ingress/p1-remediation.test.mts",
    "test:stage-e": "node --experimental-strip-types --test 'test/tournament/adjudication/**/*.test.mts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:stage-d-parity": "python3 tools/stage_d/parity/run_parity.py",
    "test:stage-d-checksums": "python3 tools/stage_d/parity/verify_checksums.py"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3"
  }
}
