{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/engine/core001v3/**/*.mts",
    "src/tournament/**/*.mts",
    "src/staging/**/*.mts",
    "test/staging/**/*.mts",
    "test/engine/core001v3/**/*.mts",
    "test/tournament/**/*.mts"
  ]
}
